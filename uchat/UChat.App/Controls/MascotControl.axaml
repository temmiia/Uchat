<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="UChat.App.Controls.MascotControl"
             Width="100"
             Height="100"
             ClipToBounds="False">

    <Grid x:Name="MascotContainer"
          Width="100"
          Height="100"
          Background="Transparent"
          RenderTransformOrigin="50%,100%"
          PointerPressed="OnMascotPointerPressed">

        <Image x:Name="WitchHat"
               ZIndex="1"
               Width="100"
               Height="85"
               Margin="6,-34,0,0"
               HorizontalAlignment="Left"
               VerticalAlignment="Top"
               Source="avares://UChat.App/Assets/witch_hat.png"
               Stretch="Uniform"
               IsVisible="False"
               RenderOptions.BitmapInterpolationMode="HighQuality" />
        <Image x:Name="LuffyHat"
               ZIndex="1"
               Width="160"
               Height="90"
               Margin="-14,-22,0,0"
               HorizontalAlignment="Left"
               VerticalAlignment="Top"
               Source="avares://UChat.App/Assets/luffy_hat.png"
               Stretch="Uniform"
               IsVisible="False"
               RenderOptions.BitmapInterpolationMode="HighQuality" />
        <Image x:Name="MascotBody"
               Source="avares://UChat.App/Assets/mascot_lightblue.png"
               Stretch="Uniform"
               RenderOptions.BitmapInterpolationMode="HighQuality" />
        <Image x:Name="LeftPupil"
               Width="12.8"
               Height="12.04"
               Margin="29.2,35.37,0,0"
               HorizontalAlignment="Left"
               VerticalAlignment="Top"
               Source="avares://UChat.App/Assets/eye-pupil-left.png"
               Stretch="Fill"
               RenderOptions.BitmapInterpolationMode="HighQuality" />
        <Image x:Name="RightPupil"
               Width="12.8"
               Height="12.04"
               Margin="52.7,35.22,0,0"
               HorizontalAlignment="Left"
               VerticalAlignment="Top"
               Source="avares://UChat.App/Assets/eye-pupil-right.png"
               Stretch="Fill"
               RenderOptions.BitmapInterpolationMode="HighQuality" />
        <Image x:Name="LeftLeg"
               Width="20"
               Height="18"
               Margin="19,67,0,0"
               HorizontalAlignment="Left"
               VerticalAlignment="Top"
               Source="avares://UChat.App/Assets/leg_lightblue.png"
               Stretch="Uniform"
               RenderTransformOrigin="50%,100%"
               RenderOptions.BitmapInterpolationMode="HighQuality" />
        <Image x:Name="RightLeg"
               Width="20"
               Height="18"
               Margin="53,67,0,0"
               HorizontalAlignment="Left"
               VerticalAlignment="Top"
               Source="avares://UChat.App/Assets/leg_lightblue.png"
               Stretch="Uniform"
               RenderTransformOrigin="50%,100%"
               RenderOptions.BitmapInterpolationMode="HighQuality" />
    </Grid>
</UserControl>
