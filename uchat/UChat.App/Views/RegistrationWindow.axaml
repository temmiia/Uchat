<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="UChat.App.Views.RegistrationWindow"
        Title="Sign up - UChat"
        Width="420"
        Height="440"
        WindowDecorations="None"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBgBrush}">
    <Grid RowDefinitions="32,*">
        <Border Grid.Row="0"
                Background="{DynamicResource PanelBgBrush}"
                BorderBrush="{DynamicResource MagicBorderBrush}"
                BorderThickness="0,0,0,1"
                PointerPressed="OnDragAreaPointerPressed">
            <TextBlock Text="UChat"
                       Margin="12,0"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource NeonLavenderBrush}"
                       FontWeight="SemiBold" />
        </Border>
        <Border Grid.Row="1"
                Margin="24"
                Padding="24"
                Background="{DynamicResource PanelBgBrush}"
                BorderBrush="{DynamicResource MagicBorderBrush}"
                BorderThickness="1"
                CornerRadius="14"
                VerticalAlignment="Center">
            <StackPanel Spacing="14">
                <TextBlock Text="Create account"
                           FontSize="24"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource NeonLavenderBrush}"
                           Margin="0,0,0,4" />
                <TextBox PlaceholderText="Username"
                         Padding="10,8"
                         Background="{DynamicResource AppBgBrush}"
                         BorderBrush="{DynamicResource MagicBorderBrush}" />
                <TextBox PlaceholderText="Display name"
                         Padding="10,8"
                         Background="{DynamicResource AppBgBrush}"
                         BorderBrush="{DynamicResource MagicBorderBrush}" />
                <TextBox PlaceholderText="Password"
                         PasswordChar="●"
                         Padding="10,8"
                         Background="{DynamicResource AppBgBrush}"
                         BorderBrush="{DynamicResource MagicBorderBrush}" />
                <Button Content="Sign up"
                        Margin="0,4,0,0"
                        Padding="12,9"
                        HorizontalAlignment="Stretch"
                        Background="{DynamicResource MagicPurpleBrush}"
                        Foreground="White"
                        Click="OnSignUpClick" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
