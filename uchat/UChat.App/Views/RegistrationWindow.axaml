<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="UChat.App.Views.RegistrationWindow"
        Title="Sign up - UChat"
        Width="420"
        Height="520"
        WindowDecorations="None"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource CanvasBrush}">

    <Grid RowDefinitions="32,*">

        <!-- Top bar (window drag) -->
        <Border Grid.Row="0"
                Background="Transparent"
                PointerPressed="OnDragAreaPointerPressed">
            <TextBlock Text="UChat"
                       Margin="16,0"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource MutedTextBrush}"
                       FontSize="12"
                       FontWeight="SemiBold" />
        </Border>

        <!-- Content card -->
        <Border Grid.Row="1"
                Margin="16,4,16,16"
                Padding="28"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrushMagic}"
                BorderThickness="1"
                CornerRadius="32"
                VerticalAlignment="Center">

            <StackPanel Spacing="14">

                <!-- Logo: accent star on dark -->
                <Border Width="56" Height="56"
                        CornerRadius="20"
                        Background="{DynamicResource AccentGradientBrush}"
                        HorizontalAlignment="Center">
                    <TextBlock Text="✱"
                               FontSize="30"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>

                <TextBlock Text="Create account"
                           FontSize="26"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextBrush}"
                           Margin="0,6,0,6" />
                <TextBox x:Name="UsernameBox" Classes="Pill" PlaceholderText="Username" />
                <TextBox x:Name="DisplayNameBox" Classes="Pill" PlaceholderText="Display name" />
                <TextBox x:Name="PasswordBox" Classes="Pill" PlaceholderText="Password" PasswordChar="*" />

                <TextBlock x:Name="ErrorText"
                           IsVisible="False"
                           Foreground="{DynamicResource DangerBrush}"
                           TextWrapping="Wrap"
                           FontSize="12" />

                <Button x:Name="SignUpButton"
                        Classes="Primary"
                        Content="Sign up"
                        Margin="0,4,0,0"
                        Padding="12,13"
                        HorizontalAlignment="Stretch"
                        Click="OnSignUpClick" />
                <Button Classes="Link"
                        Content="Already have an account? Log in"
                        HorizontalAlignment="Center"
                        Click="OnLoginClick" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
