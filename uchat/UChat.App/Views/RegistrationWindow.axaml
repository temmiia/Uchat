<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="UChat.App.Views.RegistrationWindow"
        Title="Sign up - UChat"
        Width="400"
        Height="372"
        WindowDecorations="None"
        WindowStartupLocation="CenterScreen">
    <Grid RowDefinitions="32,*">
        <Border Grid.Row="0" Background="{DynamicResource PanelBgBrush}" PointerPressed="OnDragAreaPointerPressed">
            <TextBlock Text="UChat" Margin="12,0" VerticalAlignment="Center" />
        </Border>
        <StackPanel Grid.Row="1" Margin="32" Spacing="12" VerticalAlignment="Center">
            <TextBlock Text="Create account" FontSize="24" HorizontalAlignment="Center" />
            <TextBox PlaceholderText="Username" />
            <TextBox PlaceholderText="Display name" />
            <TextBox PlaceholderText="Password" PasswordChar="●" />
            <Button Content="Sign up" HorizontalAlignment="Stretch" Click="OnSignUpClick" />
        </StackPanel>
    </Grid>
</Window>
