<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="UChat.App.Views.LoginWindow"
        Title="Log in - UChat"
        Width="400"
        Height="372"
        WindowDecorations="None"
        WindowStartupLocation="CenterScreen">
    <Grid RowDefinitions="32,*">
        <Border Grid.Row="0" Background="{DynamicResource PanelBgBrush}" PointerPressed="OnDragAreaPointerPressed">
            <TextBlock Text="UChat" Margin="12,0" VerticalAlignment="Center" />
        </Border>
        <StackPanel Grid.Row="1" Margin="24" Spacing="12" VerticalAlignment="Center">
            <TextBlock Text="Log in to UChat" FontSize="24" />
            <TextBox PlaceholderText="Username" />
            <TextBox PlaceholderText="Password" PasswordChar="●" />
            <Button Content="Log in" Click="OnLoginClick" />
        </StackPanel>
    </Grid>
</Window>