
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="UChat.App.Views.LoginWindow"
        Title="Log in - UChat"
        Width="420"
        Height="440"
        WindowDecorations="None"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBgBrush}">

    <Grid RowDefinitions="32,*">

        <!-- Верхняя панель -->
        <Border Grid.Row="0"
                Background="{DynamicResource PanelBgBrush}"
                BorderBrush="{DynamicResource MagicBorderBrush}"
                BorderThickness="0,0,0,1"
                PointerPressed="OnDragAreaPointerPressed">

            <TextBlock Text="UChat"
                       Margin="12,0"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource NeonLavenderBrush}"
                       FontWeight="SemiBold" />
        </Border>

        <!-- Карточка авторизации -->
        <Border Grid.Row="1"
                Margin="24"
                Padding="24"
                Background="{DynamicResource PanelBgBrush}"
                BorderBrush="{DynamicResource MagicBorderBrush}"
                BorderThickness="1"
                CornerRadius="14"
                VerticalAlignment="Center">

            <StackPanel Spacing="14">

                <TextBlock Text="Welcome back!"
                           FontSize="24"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource NeonLavenderBrush}"
                           Margin="0,0,0,4" />

                <TextBox x:Name="UsernameBox"
                         PlaceholderText="Username"
                         Padding="10,8"
                         Background="{DynamicResource AppBgBrush}"
                         BorderBrush="{DynamicResource MagicBorderBrush}" />

                <TextBox x:Name="PasswordBox"
                         PlaceholderText="Password"
                         PasswordChar="*"
                         Padding="10,8"
                         Background="{DynamicResource AppBgBrush}"
                         BorderBrush="{DynamicResource MagicBorderBrush}" />

                <!-- Ошибки авторизации -->
                <TextBlock x:Name="ErrorText"
                           IsVisible="False"
                           Foreground="#FF6B6B"
                           TextWrapping="Wrap"
                           FontSize="12" />

                <!-- Вход через бэкенд -->
                <Button x:Name="LoginButton"
                        Content="Log in"
                        Margin="0,4,0,0"
                        Padding="12,9"
                        HorizontalAlignment="Stretch"
                        Background="{DynamicResource MagicPurpleBrush}"
                        Foreground="White"
                        Click="OnLoginClick" />

                <!-- Переход на регистрацию -->
                <Button Content="Don't have an account? Sign up"
                        HorizontalAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="{DynamicResource NeonLavenderBrush}"
                        Click="OnRegisterClick" />

            </StackPanel>
        </Border>
    </Grid>
</Window>
