<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:UChat.App.ViewModels"
        xmlns:models="using:UChat.App.Models"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="650"
        x:Class="UChat.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        PointerMoved="OnPointerMoved"
        Title="UChat"
        MinWidth="760" MinHeight="500"
        WindowDecorations="None"
        Background="{DynamicResource AppBgBrush}">

    <Window.Styles>
        <Style Selector="Button.CaptionBtn">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style Selector="Button.CaptionBtn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#20FFFFFF"/>
        </Style>

        <Style Selector="Button.CloseBtn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#E81123"/>
        </Style>

        <Style Selector="Button.CloseBtn:pointerover">
            <Setter Property="Foreground" Value="White"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="32, *">
        <!-- Власна верхня панель вікна -->
        <Grid Grid.Row="0"
              Background="{DynamicResource AppBgBrush}"
              PointerPressed="OnTitleBarPointerPressed">
            <StackPanel Orientation="Horizontal"
                        Spacing="6"
                        Margin="6,0,0,0"
                        VerticalAlignment="Center">

                <TextBlock Text="UChat"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Opacity="0.6" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <!-- Згорнути  -->
                <Button Classes="CaptionBtn" Click="OnMinimizeClick">
                    <Viewbox Width="12" Height="12">
                        <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="2" StrokeLineCap="Round"
                              Data="M5 12 H19" />
                    </Viewbox>
                </Button>

                <!-- Розгорнути / Відновити  -->
                <Button Classes="CaptionBtn" Click="OnMaximizeClick">
                    <Viewbox Width="12" Height="12">
                        <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round"
                              Data="M5 3 H19 A2 2 0 0 1 21 5 V19 A2 2 0 0 1 19 21 H5 A2 2 0 0 1 3 19 V5 A2 2 0 0 1 5 3 Z" />
                    </Viewbox>
                </Button>

                <!-- Закрити  -->
                <Button Classes="CaptionBtn CloseBtn" Click="OnCloseClick">
                    <Viewbox Width="12" Height="12">
                        <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="2" StrokeLineCap="Round"
                              Data="M18 6 6 18 M6 6 18 18" />
                    </Viewbox>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Основний вміст вікна -->
        <Grid Grid.Row="1" ColumnDefinitions="300,*">
            <!-- Бічна панель містить заголовок, пошук і список доступних чатів. -->
            <Border Grid.Column="0"
                    Background="{DynamicResource PanelBgBrush}"
                    BorderBrush="{DynamicResource MagicBorderBrush}"
                    BorderThickness="0,0,1,0">
                <Grid RowDefinitions="Auto,Auto,*">
                    <!-- Заголовок і поле пошуку чатів. Значення пошуку оновлює список одразу. -->
                    <TextBlock Grid.Row="0"
                               Text="Messages"
                               Margin="18,20,18,14"
                               FontSize="22"
                               FontWeight="SemiBold" />

                    <Grid Grid.Row="0"
                          x:Name="MascotContainer"
                          Margin="180,0,50,0"
                          Width="100"
                          Height="100"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Center">
                        <Image Source="avares://UChat.App/Assets/mascot.png"
                               Stretch="Uniform" />
                        <Image x:Name="LeftPupil"
                               Width="12.8"
                               Height="12.04"
                               Margin="26.75,35.37,0,0"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Top"
                               Source="avares://UChat.App/Assets/eye-pupil-left.png"
                               Stretch="Fill" />
                        <Image x:Name="RightPupil"
                               Width="12.8"
                               Height="12.04"
                               Margin="54.38,35.22,0,0"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Top"
                               Source="avares://UChat.App/Assets/eye-pupil-right.png"
                               Stretch="Fill" />
                    </Grid>

                    <TextBox Grid.Row="1"
                             Margin="12,0,12,10"
                             Padding="10,8"
                             PlaceholderText="Search chats"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />

                    <!-- Список відфільтрованих чатів; вибраний елемент визначає відкриту переписку. -->
                    <ListBox Grid.Row="2"
                             Background="Transparent"
                             ItemsSource="{Binding VisibleChats}"
                             SelectedItem="{Binding SelectedChat, Mode=TwoWay}">
                        <!-- Шаблон одного чату: ініціали, ім'я, останнє повідомлення та час. -->
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="models:ChatPreview">
                                <Border Padding="10" CornerRadius="10">
                                    <Grid ColumnDefinitions="42,*" RowDefinitions="Auto,Auto">
                                        <Border Grid.RowSpan="2"
                                                Width="38" Height="38"
                                                CornerRadius="19"
                                                Background="{DynamicResource MagicPurpleBrush}"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding AvatarInitials}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontWeight="SemiBold"
                                                       Foreground="White" />
                                        </Border>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Name}"
                                                   Margin="5,0,0,0"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Row="1" Grid.Column="1"
                                                   Text="{Binding LastMessage}"
                                                   Margin="5,3,0,0"
                                                   FontSize="12"
                                                   Opacity="0.7"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Row="0" Grid.Column="1"
                                                   Text="{Binding Time}"
                                                   HorizontalAlignment="Right"
                                                   FontSize="11"
                                                   Opacity="0.6" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Область відкритої переписки: заголовок, історія повідомлень і поле введення. -->
            <Grid Grid.Column="1" RowDefinitions="68,Auto,*,Auto">
                <!-- Ім'я співрозмовника або назва групи вибраного чату. -->
                <Border Grid.Row="0"
                        Background="{DynamicResource PanelBgBrush}"
                        BorderBrush="{DynamicResource MagicBorderBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="20,0">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{Binding SelectedChat.Name}"
                                   VerticalAlignment="Center"
                                   FontSize="17"
                                   FontWeight="SemiBold" />
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    Spacing="8"
                                    VerticalAlignment="Center">
                            <Border Width="8"
                                    Height="8"
                                    CornerRadius="4"
                                    Background="{Binding ConnectionStatusBrush}" />
                            <TextBlock Text="{Binding ConnectionStatusText}"
                                       FontSize="12"
                                       Opacity="0.8"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="1"
                        IsVisible="{Binding IsCatchUpNotificationVisible}"
                        Margin="12,10,12,0"
                        Padding="12,8"
                        CornerRadius="8"
                        Background="#2634D399">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{Binding CatchUpNotificationText}"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="1"
                                Content="×"
                                Padding="8,0"
                                Background="Transparent"
                                Command="{Binding DismissCatchUpNotificationCommand}" />
                    </Grid>
                </Border>

                <!-- Історія повідомлень прокручується; вирівнювання кожного повідомлення задається моделлю. -->
                <ScrollViewer Grid.Row="2" Padding="18">
                    <ItemsControl ItemsSource="{Binding SelectedChat.Messages}">
                        <!-- Бульбашка повідомлення з текстом і часом відправлення. -->
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:ChatMessage">
                                <Border MaxWidth="520"
                                        Margin="0, 5"
                                        Padding="12,9"
                                        CornerRadius="12"
                                        Background="{DynamicResource PanelBgBrush}"
                                        HorizontalAlignment="{Binding Alignment}">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Time}"
                                                   FontSize="10"
                                                   Opacity="0.65"
                                                   HorizontalAlignment="Right" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Поле для нового повідомлення та кнопка відправлення. Enter виконує ту саму команду. -->
                <Border Grid.Row="3"
                        Background="{DynamicResource PanelBgBrush}"
                        BorderBrush="{DynamicResource MagicBorderBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBox Grid.Column="0"
                                 PlaceholderText="Type a message..."
                                 VerticalContentAlignment="Center"
                                 Text="{Binding DraftText, UpdateSourceTrigger=PropertyChanged}">
                            <TextBox.KeyBindings>
                                <KeyBinding Gesture="Enter" Command="{Binding SendMessageCommand}" />
                            </TextBox.KeyBindings>
                        </TextBox>
                        <Button Grid.Column="1"
                                Margin="10,0,0,0"
                                Padding="18,8"
                                Content="Send"
                                Command="{Binding SendMessageCommand}"
                                Background="{DynamicResource MagicPurpleBrush}"
                                Foreground="White" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>

    </Grid>
</Window>
