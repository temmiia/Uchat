
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:UChat.App.ViewModels"
        xmlns:models="using:UChat.App.Models"
        x:Class="UChat.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Width="1000"
        Height="650"
        Title="UChat"
        Background="{DynamicResource AppBgBrush}">

    <Grid ColumnDefinitions="280,*">

        <Border Grid.Column="0"
                Background="{DynamicResource PanelBgBrush}"
                Padding="12">

            <Grid RowDefinitions="Auto,Auto,Auto,*"
                  RowSpacing="10">

                <TextBlock Grid.Row="0"
                           Text="UChat"
                           FontSize="24"
                           FontWeight="Bold"/>

                <StackPanel Grid.Row="1" Spacing="8">

                    <TextBox Watermark="Username for new chat"
                             Text="{Binding NewChatUsername}"/>

                    <Button Content="New Chat"
                            Command="{Binding CreateChatCommand}"/>

                </StackPanel>

                <Button Grid.Row="2"
                        Content="Refresh"
                        Command="{Binding RefreshConversationsCommand}"/>

                <ListBox Grid.Row="3"
                         ItemsSource="{Binding Conversations}"
                         SelectedItem="{Binding SelectedConversation}">

                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="models:ChatConversation">
                            <TextBlock Text="{Binding DisplayName}"
                                       Margin="8"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>

                </ListBox>

            </Grid>
        </Border>

        <Grid Grid.Column="1"
              RowDefinitions="60,*,Auto,Auto">

            <Border Grid.Row="0"
                    Background="{DynamicResource PanelBgBrush}"
                    Padding="16">

                <TextBlock Text="{Binding SelectedConversation.DisplayName}"
                           FontSize="18"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
            </Border>

            <ScrollViewer Grid.Row="1"
                          Padding="15">

                <ItemsControl ItemsSource="{Binding Messages}">

                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:ChatMessage">

                            <StackPanel Margin="0,4">

                                <TextBlock Text="{Binding SenderAccountId}"
                                           FontSize="11"
                                           Opacity="0.6"/>

                                <TextBlock Text="{Binding Content}"
                                           FontSize="15"
                                           TextWrapping="Wrap"/>

                            </StackPanel>

                        </DataTemplate>
                    </ItemsControl.ItemTemplate>

                </ItemsControl>

            </ScrollViewer>

            <TextBlock Grid.Row="2"
                       Text="{Binding Status}"
                       Margin="12,4"
                       FontSize="12"
                       Opacity="0.7"/>

            <Grid Grid.Row="3"
                  ColumnDefinitions="*,Auto"
                  Margin="12">

                <TextBox Grid.Column="0"
                         Text="{Binding MessageText}"
                         Watermark="Type a message..."
                         Margin="0,0,10,0"/>

                <Button Grid.Column="1"
                        Content="Send"
                        Command="{Binding SendMessageCommand}"
                        Background="{DynamicResource MagicPurpleBrush}"
                        Foreground="White"/>

            </Grid>

        </Grid>
    </Grid>
</Window>
