
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:UChat.App.ViewModels"
        xmlns:models="using:UChat.App.Models"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="650"
        x:Name="MainRoot"
        x:Class="UChat.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        PointerMoved="OnPointerMoved"
        Title="UChat"
        MinWidth="760" MinHeight="500"
        WindowDecorations="None"
        Background="{DynamicResource CanvasBrush}">

    <Window.Styles>
        <!-- Кнопки заголовка вікна -->
        <Style Selector="Button.CaptionBtn">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.CaptionBtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#20FFFFFF"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        </Style>
        <Style Selector="Button.CloseBtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#E81123"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.CloseBtn:pointerover">
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <!-- Кнопки дій у лівій панелі -->
        <Style Selector="Button.ChatAction">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="22"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.ChatAction:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#8B5CF6"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.ChatAction:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#6D28D9"/>
        </Style>
        <Style Selector="Button.RailAction">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="13"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.RailAction:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#8B5CF6"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.RailAction:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#6D28D9"/>
        </Style>

        <!-- Рамка поля вводу: при фокусі підсвічується -->
        <Style Selector="Border.InputFrame.focused">
            <Setter Property="BorderBrush" Value="{DynamicResource NeonBrush}"/>
        </Style>
        <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <!-- Список чатів: прибираємо стандартне виділення, малюємо власне на картці -->
        <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="24"/>
        </Style>
        <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ListBoxItem:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <!-- Картка чату: темна; вибрана - лаймова з чорним текстом -->
        <Style Selector="Border.ChatCard">
            <Setter Property="Background" Value="{DynamicResource SidebarCardBrush}"/>
        </Style>
        <Style Selector="ListBoxItem:pointerover Border.ChatCard">
            <Setter Property="Background" Value="#2A1F47"/>
        </Style>
        <Style Selector="ListBoxItem:selected Border.ChatCard">
            <Setter Property="Background" Value="{DynamicResource AccentGradientBrush}"/>
            <Setter Property="BoxShadow" Value="0 6 24 0 #667C3AED"/>
        </Style>
        <Style Selector="ListBoxItem:selected Border.ChatCard TextBlock.ChatName">
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="ListBoxItem:selected Border.ChatCard TextBlock.ChatSub">
            <Setter Property="Foreground" Value="#CCFFFFFF"/>
        </Style>
        <Style Selector="ListBoxItem:selected Border.ChatCard Border.Avatar">
            <Setter Property="Background" Value="White"/>
        </Style>
        <Style Selector="ListBoxItem:selected Border.ChatCard Border.Avatar TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
        </Style>

        <!-- Повідомлення: чужі - білі зліва, свої - чорні справа -->
        <Style Selector="Border.Msg">
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
        <Style Selector="Border.Msg TextBlock.MsgText">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        </Style>
        <Style Selector="Border.Msg TextBlock.MsgTime">
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
        </Style>
        <Style Selector="Border.Msg.own">
            <Setter Property="Background" Value="{DynamicResource AccentGradientBrush}"/>
            <Setter Property="BoxShadow" Value="0 4 16 0 #447C3AED"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>
        <Style Selector="Border.Msg.own TextBlock.MsgText">
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Border.Msg.own TextBlock.MsgTime">
            <Setter Property="Foreground" Value="#99FFFFFF"/>
        </Style>

        <!-- «Load older messages» -->
        <Style Selector="Button.LoadOlderBtn">
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="16,7"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style Selector="Button.LoadOlderBtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="32, *">
        <!-- Власна верхня панель вікна -->
        <Grid Grid.Row="0"
              Background="Transparent"
              PointerPressed="OnTitleBarPointerPressed">

            <StackPanel Orientation="Horizontal"
                        Spacing="8"
                        Margin="18,0,0,0"
                        VerticalAlignment="Center">
                <TextBlock Text="✱"
                           FontSize="14"
                           Foreground="{DynamicResource NeonBrush}"
                           VerticalAlignment="Center" />
                <TextBlock Text="UChat"
                           VerticalAlignment="Center"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource MutedTextBrush}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <!-- Згорнути -->
                <Button Classes="CaptionBtn" Click="OnMinimizeClick">
                    <Viewbox Width="12" Height="12">
                        <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="2" StrokeLineCap="Round"
                              Data="M5 12 H19" />
                    </Viewbox>
                </Button>

                <!-- Розгорнути / Відновити -->
                <Button Classes="CaptionBtn" Click="OnMaximizeClick">
                    <Viewbox Width="12" Height="12">
                        <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round"
                              Data="M5 3 H19 A2 2 0 0 1 21 5 V19 A2 2 0 0 1 19 21 H5 A2 2 0 0 1 3 19 V5 A2 2 0 0 1 5 3 Z" />
                    </Viewbox>
                </Button>

                <!-- Закрити -->
                <Button Classes="CaptionBtn CloseBtn" Click="OnCloseClick">
                    <Viewbox Width="12" Height="12">
                        <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="2" StrokeLineCap="Round"
                              Data="M18 6 6 18 M6 6 18 18" />
                    </Viewbox>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Основний вміст вікна -->
        <Grid Grid.Row="1" ColumnDefinitions="56,312,*" Margin="12,0,12,12">

            <StackPanel Grid.Column="0"
                        Orientation="Vertical"
                        Spacing="10"
                        Margin="0,18,12,0">
                <Button Classes="RailAction"
                        Command="{Binding ToggleNewChatInputCommand}"
                        ToolTip.Tip="Username for new chat">
                    <PathIcon Width="18" Height="18"
                              Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}">
                        <PathIcon.Data>
                            <GeometryGroup>
                                <StreamGeometry>
                                    M46.4,69.267
                                    h33.109
                                    c2.018,0,3.873-0.818,5.182-2.128
                                    c1.364-1.309,2.127-3.055,2.127-4.965
                                    V51.427 v-12.93
                                    c0-1.418,0.709-2.673,1.8-3.382
                                    c0.655-0.436,1.473-0.709,2.291-0.709
                                    c2.291,0,4.091,1.8,4.091,4.092
                                    v12.93 v10.748
                                    c0,8.456-6.982,15.276-15.491,15.276
                                    H47.655 L22.727,94.309
                                    c-0.927,0.655-2.073,0.818-3.109,0.6
                                    c-0.164,0-0.382-0.055-0.545-0.164
                                    c-0.382-0.164-0.764-0.327-1.091-0.6
                                    c-0.327-0.218-0.655-0.546-0.927-0.927
                                    c-0.491-0.709-0.709-1.473-0.709-2.291
                                    V76.851 C9.8,75.105,5,69.213,5,62.175
                                    V51.427 V19.73 v-0.382
                                    l0.055-0.6 l0.055-0.055
                                    C5.927,10.947,12.473,5,20.436,5
                                    h41.073 C63.8,5,65.6,6.8,65.6,9.092
                                    c0,2.237-1.8,4.092-4.091,4.092
                                    H20.436 c-3.764,0-6.764,2.782-7.2,6.274
                                    v0.109 l-0.055,0.327 v31.534 v10.748
                                    c0,3.819,3.218,7.092,7.255,7.092
                                    c2.236,0,4.091,1.855,4.091,4.092
                                    v9.875 l19.582-13.257
                                    c0.273-0.164,0.545-0.327,0.818-0.436
                                    c0.218-0.109,0.436-0.164,0.655-0.164
                                    C45.855,69.267,46.127,69.267,46.4,69.267 z
                                </StreamGeometry>
                                <StreamGeometry>
                                    M65.273,17.603
                                    c0.764-0.764,1.8-1.2,2.891-1.2 h7.255
                                    V9.092 C75.418,6.8,77.273,5,79.509,5
                                    C81.8,5,83.6,6.8,83.6,9.092 v7.311 h7.309
                                    c2.291,0,4.091,1.8,4.091,4.092
                                    c0,2.237-1.8,4.092-4.091,4.092 H83.6
                                    v7.256 c0,1.091-0.436,2.128-1.2,2.891
                                    c-0.709,0.709-1.745,1.2-2.891,1.2
                                    c-2.236,0-4.091-1.855-4.091-4.092
                                    v-7.256 h-7.255
                                    c-2.236,0-4.091-1.855-4.091-4.092
                                    C64.073,19.348,64.564,18.312,65.273,17.603 z
                                </StreamGeometry>
                            </GeometryGroup>
                        </PathIcon.Data>
                    </PathIcon>
                </Button>
                <Button Classes="RailAction"
                        Command="{Binding RefreshConversationsCommand}"
                        ToolTip.Tip="Refresh">
                    <Viewbox Width="18" Height="18">
                        <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="2"
                              StrokeLineCap="Round"
                              StrokeJoin="Round"
                              Data="M20 11 A8 8 0 0 0 6 5 L4 7 M4 3 V7 H8 M4 13 A8 8 0 0 0 18 19 L20 17 M20 21 V17 H16" />
                    </Viewbox>
                </Button>
                <Button Classes="RailAction" Margin="0,428,0,0" Background="#10FFFFFF"
                        ToolTip.Tip="Settings">
                    <PathIcon Width="18" Height="18"
                              Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              Data="M92.9,40c-2-0.2-4.1-0.4-6.5-0.5c-0.8-2.7-1.9-5.3-3.2-7.8c1.6-1.8,3-3.5,4.2-5c0.7-0.9,0.8-2.1,0.1-3c-3.1-4.4-6.9-8.2-11.2-11.2c-0.9-0.7-2.2-0.6-3,0.1c-1.5,1.2-3.2,2.7-5,4.2c-2.5-1.4-5.1-2.4-7.8-3.2C60.4,11.2,60.2,9,60,7.1c-0.1-1.1-1-2-2.1-2.2c-5.3-0.9-10.6-0.9-15.9,0c-1.1,0.2-2,1.1-2.1,2.2c-0.2,1.9-0.4,4.1-0.5,6.5c-2.7,0.8-5.3,1.9-7.8,3.2c-1.8-1.6-3.5-3-5-4.2c-0.9-0.7-2.1-0.8-3-0.1c-4.4,3.1-8.2,6.9-11.2,11.2c-0.7,0.9-0.6,2.2,0.1,3c1.2,1.5,2.7,3.2,4.2,5c-1.4,2.5-2.4,5.1-3.2,7.8C11.2,39.6,9,39.8,7.1,40c-1.1,0.1-2,1-2.2,2.1c-0.5,2.7-0.7,5.3-0.7,7.9c0,2.6,0.2,5.3,0.7,7.9c0.2,1.1,1.1,2,2.2,2.1c1.9,0.2,4.1,0.4,6.5,0.5c0.8,2.7,1.9,5.3,3.2,7.8c-1.6,1.8-3,3.5-4.2,5c-0.7,0.9-0.8,2.1-0.1,3c3.1,4.4,6.9,8.2,11.2,11.2c0.9,0.7,2.2,0.6,3-0.1c1.5-1.3,3.2-2.7,5-4.2c2.5,1.4,5.1,2.4,7.8,3.2c0.2,2.4,0.3,4.6,0.5,6.5c0.1,1.1,1,2,2.1,2.2c2.7,0.5,5.3,0.7,7.9,0.7c2.6,0,5.3-0.2,7.9-0.7c1.1-0.2,2-1.1,2.1-2.2c0.2-1.9,0.4-4.1,0.5-6.5c2.7-0.8,5.3-1.9,7.8-3.2c1.8,1.6,3.5,3,5,4.2c0.9,0.7,2.1,0.8,3,0.1c4.4-3.1,8.2-6.9,11.2-11.2c0.7-0.9,0.6-2.2-0.1-3c-1.2-1.5-2.7-3.2-4.2-5c1.4-2.5,2.4-5.1,3.2-7.8c2.4-0.2,4.6-0.3,6.5-0.5c1.1-0.1,2-1,2.2-2.1c0.5-2.7,0.7-5.3,0.7-7.9c0-2.6-0.2-5.3-0.7-7.9C95,40.9,94.1,40.1,92.9,40z M90.5,55.2c-1.9,0.2-4,0.3-6.2,0.4c-1.1,0.1-2,0.9-2.3,1.9c-0.8,3.4-2.2,6.7-4,9.7c-0.6,0.9-0.5,2.2,0.3,3c1.5,1.7,2.9,3.3,4.1,4.7c-2.1,2.7-4.6,5.2-7.3,7.3c-1.4-1.2-3-2.6-4.7-4.1c-0.8-0.7-2.1-0.8-3-0.3c-3,1.9-6.3,3.2-9.7,4c-1.1,0.3-1.9,1.2-1.9,2.3c-0.1,2.2-0.3,4.3-0.4,6.2c-3.5,0.4-6.9,0.4-10.4,0c-0.2-1.9-0.3-4-0.4-6.2c-0.1-1.1-0.9-2-1.9-2.3c-3.4-0.8-6.7-2.2-9.7-4c-0.9-0.6-2.2-0.5-3,0.3c-1.7,1.5-3.3,2.9-4.7,4.1c-2.7-2.1-5.2-4.6-7.3-7.3c1.2-1.4,2.6-3,4.1-4.7c0.7-0.8,0.8-2,0.3-3c-1.9-3-3.2-6.3-4-9.7c-0.3-1.1-1.2-1.9-2.3-1.9c-2.2-0.1-4.3-0.3-6.2-0.4c-0.2-1.7-0.3-3.5-0.3-5.2c0-1.7,0.1-3.4,0.3-5.2c1.9-0.2,4-0.3,6.2-0.4c1.1-0.1,2-0.9,2.3-1.9c0.8-3.4,2.2-6.7,4-9.7c0.6-0.9,0.5-2.2-0.3-3c-1.5-1.7-2.9-3.3-4.1-4.7c2.1-2.7,4.6-5.2,7.3-7.3c1.4,1.2,3,2.6,4.7,4.1c0.8,0.7,2,0.8,3,0.3c3-1.9,6.3-3.2,9.7-4c1.1-0.3,1.9-1.2,1.9-2.3c0.1-2.2,0.3-4.3,0.4-6.2c3.5-0.4,6.9-0.4,10.4,0c0.2,1.9,0.3,4,0.4,6.2c0.1,1.1,0.9,2,1.9,2.3c3.4,0.8,6.7,2.2,9.7,4c0.9,0.6,2.2,0.5,3-0.3c1.7-1.5,3.3-2.9,4.7-4.1c2.7,2.1,5.2,4.6,7.3,7.3c-1.2,1.4-2.6,3-4.1,4.7c-0.7,0.8-0.8,2.1-0.3,3c1.9,3,3.2,6.3,4,9.7c0.3,1.1,1.2,1.9,2.3,1.9c2.2,0.1,4.3,0.3,6.2,0.4c0.2,1.7,0.3,3.5,0.3,5.2C90.8,51.7,90.7,53.4,90.5,55.2z M50,24.7c-13.9,0-25.3,11.3-25.3,25.3c0,13.9,11.3,25.3,25.3,25.3c13.9,0,25.3-11.3,25.3-25.3C75.3,36.1,63.9,24.7,50,24.7z M50,70.2c-11.1,0-20.2-9.1-20.2-20.2c0-11.1,9.1-20.2,20.2-20.2c11.1,0,20.2,9.1,20.2,20.2C70.2,61.1,61.1,70.2,50,70.2z" />
                </Button>
            </StackPanel>

            <!-- ============ ЧОРНА БІЧНА ПАНЕЛЬ ============ -->
            <Border Grid.Column="1"
                    Margin="0,0,12,0"
                    Background="{DynamicResource SidebarBrush}"
                    BorderBrush="{DynamicResource BorderBrushMagic}"
                    BorderThickness="1"
                    CornerRadius="32"
                    ClipToBounds="False">
                <Grid RowDefinitions="Auto,Auto,Auto,Auto,*">

                    <!-- Назва, яку маскот "краде" (див. MainWindow.axaml.cs) -->
                    <TextBlock x:Name="TitleText"
                               Grid.Row="0"
                               Text="Messages"
                               Margin="22,33,18,14"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Top"
                               ZIndex="5"
                               IsHitTestVisible="False"
                               RenderTransformOrigin="50%,50%"
                               Foreground="White"
                               FontSize="25"
                               FontWeight="SemiBold" />

                    <Grid Grid.Row="0"
                          x:Name="MascotContainer"
                          ZIndex="10"
                          Margin="180,0,50,0"
                          Width="100"
                          Height="100"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Center"
                          RenderTransformOrigin="50%,100%"
                          PointerPressed="OnMascotPointerPressed">
                        <Image Source="avares://UChat.App/Assets/mascot.png"
                                 Stretch="Uniform"
                                 RenderOptions.BitmapInterpolationMode="HighQuality" />
                        <Image x:Name="WitchHat"
                                 ZIndex="1"
                                 Width="100"
                                 Height="85"
                                 Margin="6,-34,0,0"
                                 HorizontalAlignment="Left"
                                 VerticalAlignment="Top"
                                 Source="avares://UChat.App/Assets/witch_hat.png"
                                    Stretch="Uniform"
                                    RenderOptions.BitmapInterpolationMode="HighQuality" />
                          <Image x:Name="LeftPupil"
                                 Width="12.8"
                                 Height="12.04"
                                 Margin="29.2,35.37,0,0"
                                 HorizontalAlignment="Left"
                                 VerticalAlignment="Top"
                                 Source="avares://UChat.App/Assets/eye-pupil-left.png"
                                 Stretch="Fill"
                                 RenderOptions.BitmapInterpolationMode="HighQuality" />
                          <Image x:Name="RightPupil"
                                 Width="12.8"
                                 Height="12.04"
                                 Margin="52.7,35.22,0,0"
                                 HorizontalAlignment="Left"
                                 VerticalAlignment="Top"
                                 Source="avares://UChat.App/Assets/eye-pupil-right.png"
                                 Stretch="Fill"
                                 RenderOptions.BitmapInterpolationMode="HighQuality" />
                        <Image x:Name="LeftLeg"
                                 Width="20"
                                 Height="18"
                                 Margin="19,67,0,0"
                                 HorizontalAlignment="Left"
                                 VerticalAlignment="Top"
                                 Source="avares://UChat.App/Assets/leg.png"
                                 Stretch="Uniform"
                                 RenderTransformOrigin="50%,100%"
                                 RenderOptions.BitmapInterpolationMode="HighQuality" />
                        <Image x:Name="RightLeg"
                                 Width="20"
                                 Height="18"
                                 Margin="53,67,0,0"
                                 HorizontalAlignment="Left"
                                 VerticalAlignment="Top"
                                 Source="avares://UChat.App/Assets/leg.png"
                                 Stretch="Uniform"
                                 RenderTransformOrigin="50%,100%"
                                 RenderOptions.BitmapInterpolationMode="HighQuality" />
                    </Grid>

                    <!-- Пошук: світла «пілюля» на чорному -->
                    <Border Grid.Row="1"
                            x:Name="SearchInputFrame"
                            Classes="InputFrame"
                            Margin="16,0,16,12"
                            Padding="14,4"
                            Background="{DynamicResource SidebarCardBrush}"
                            BorderBrush="{DynamicResource SidebarCardBrush}"
                            BorderThickness="1.5"
                            CornerRadius="22">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <Path Width="16"
                                  Height="16"
                                  Stroke="{DynamicResource NeonBrush}"
                                  StrokeThickness="1.8"
                                  StrokeLineCap="Round"
                                  Data="M11 11 L16 16 M12.5 7.5 A5 5 0 1 1 2.5 7.5 A5 5 0 0 1 12.5 7.5 Z"
                                  VerticalAlignment="Center" />
                            <TextBox Grid.Column="1"
                                     x:Name="SearchInput"
                                     FocusAdorner="{x:Null}"
                                     Background="Transparent"
                                     Foreground="White"
                                     PlaceholderForeground="#8F82B3"
                                     BorderThickness="0"
                                     Padding="0,8"
                                     VerticalContentAlignment="Center"
                                     GotFocus="OnInputGotFocus"
                                     LostFocus="OnInputLostFocus"
                                     PlaceholderText="Search chats"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>
                    </Border>

                    <!-- Кнопки дій: круглі, лаймові -->
                    <StackPanel Grid.Row="2"
                                IsVisible="False"
                                Orientation="Horizontal"
                                Spacing="10"
                                Margin="16,0,16,14">
                        <Button Classes="ChatAction"
                                Command="{Binding ToggleNewChatInputCommand}"
                                ToolTip.Tip="Username for new chat">
                            <PathIcon Width="20" Height="20"
                                      Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}">
                                <PathIcon.Data>
                                    <GeometryGroup>
                                                <StreamGeometry>
                                                M46.4,69.267
                                                h33.109
                                                c2.018,0,3.873-0.818,5.182-2.128
                                                c1.364-1.309,2.127-3.055,2.127-4.965
                                                V51.427
                                                v-12.93
                                                c0-1.418,0.709-2.673,1.8-3.382
                                                c0.655-0.436,1.473-0.709,2.291-0.709
                                                c2.291,0,4.091,1.8,4.091,4.092
                                                v12.93
                                                v10.748
                                                c0,8.456-6.982,15.276-15.491,15.276
                                                H47.655
