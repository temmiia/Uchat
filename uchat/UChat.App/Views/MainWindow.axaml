                                                c-0.927,0.655-2.073,0.818-3.109,0.6
                                                c-0.164,0-0.382-0.055-0.545-0.164
                                                c-0.382-0.164-0.764-0.327-1.091-0.6
                                                c-0.327-0.218-0.655-0.546-0.927-0.927
                                                c-0.491-0.709-0.709-1.473-0.709-2.291
                                                V76.851
                                                C9.8,75.105,5,69.213,5,62.175
                                                V51.427
                                                V19.73
                                                v-0.382
                                                l0.055-0.6
                                                l0.055-0.055
                                                C5.927,10.947,12.473,5,20.436,5
                                                h41.073
                                                C63.8,5,65.6,6.8,65.6,9.092
                                                c0,2.237-1.8,4.092-4.091,4.092
                                                H20.436
                                                c-3.764,0-6.764,2.782-7.2,6.274
                                                v0.109
                                                l-0.055,0.327
                                                v31.534
                                                v10.748
                                                c0,3.819,3.218,7.092,7.255,7.092
                                                c2.236,0,4.091,1.855,4.091,4.092
                                                v9.875
                                                l19.582-13.257
                                                c0.273-0.164,0.545-0.327,0.818-0.436
                                                c0.218-0.109,0.436-0.164,0.655-0.164
                                                C45.855,69.267,46.127,69.267,46.4,69.267
                                                z
                                                </StreamGeometry>
                                                <StreamGeometry>
                                                M65.273,17.603
                                                c0.764-0.764,1.8-1.2,2.891-1.2
                                                h7.255
                                                V9.092
                                                C75.418,6.8,77.273,5,79.509,5
                                                C81.8,5,83.6,6.8,83.6,9.092
                                                v7.311
                                                h7.309
                                                c2.291,0,4.091,1.8,4.091,4.092
                                                c0,2.237-1.8,4.092-4.091,4.092
                                                H83.6
                                                v7.256
                                                c0,1.091-0.436,2.128-1.2,2.891
                                                c-0.709,0.709-1.745,1.2-2.891,1.2
                                                c-2.236,0-4.091-1.855-4.091-4.092
                                                v-7.256
                                                h-7.255
                                                c-2.236,0-4.091-1.855-4.091-4.092
                                                C64.073,19.348,64.564,18.312,65.273,17.603
                                                z
                                                </StreamGeometry>
                                            </GeometryGroup>
                                </PathIcon.Data>
                            </PathIcon>
                        </Button>

                        <Button Classes="ChatAction"
                                Command="{Binding CreateChatCommand}"
                                ToolTip.Tip="New chat">
                            <Viewbox Width="20" Height="20">
                                <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="2"
                                      StrokeLineCap="Round"
                                      Data="M12 2 A10 10 0 1 1 2 12 A10 10 0 0 1 12 2 Z M12 7 V17 M7 12 H17" />
                            </Viewbox>
                        </Button>

                        <Button Classes="ChatAction"
                                Command="{Binding RefreshConversationsCommand}"
                                ToolTip.Tip="Refresh">
                            <PathIcon Width="20" Height="20"
                                      Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      Data="m 49.969 11.805 c -13.652 0 -26.277 7.2812 -33.105 19.098 l 0.003907 -0.003906 c -0.85938 1.4844 -0.35156 3.3789 1.1289 4.2344 c 1.4844 0.85547 3.3789 0.34766 4.2344 -1.1367 c 5.7227 -9.9062 16.293 -15.988 27.738 -15.988 c 15.637 0 28.613 11.117 31.449 25.898 l -8.5156 -5.5391 c -1.4375 -0.92578 -3.3555 -0.51563 -4.2852 0.91797 c -0.93359 1.4336 -0.52734 3.3477 0.89844 4.2812 l 13.883 9.0352 v 0.003907 c 0.039062 0.023437 0.078124 0.042969 0.11328 0.066406 c 0.023437 0.011719 0.046875 0.023437 0.070312 0.03125 c 0.097657 0.058594 0.19922 0.10938 0.30469 0.15234 c 0.023437 0.011719 0.046875 0.019531 0.070312 0.027343 c 0.09375 0.039063 0.1875 0.070313 0.28516 0.10156 c 0.046874 0.011719 0.089843 0.023437 0.13672 0.03125 c 0.082032 0.023437 0.16797 0.039063 0.25391 0.054687 c 0.050782 0.007813 0.10156 0.015626 0.15234 0.019532 c 0.082032 0.011718 0.16406 0.015625 0.25 0.019531 c 0.019532 0.003906 0.042969 0.003906 0.066406 0.003906 c 0.03125 0 0.0625 -0.003906 0.09375 -0.003906 c 0.082032 -0.003906 0.16406 -0.007813 0.24609 -0.015625 c 0.054688 -0.007812 0.10938 -0.015625 0.16016 -0.027344 c 0.085938 -0.011718 0.16797 -0.03125 0.25 -0.050781 c 0.042969 -0.015625 0.085938 -0.027344 0.12891 -0.042969 c 0.078125 -0.023437 0.16016 -0.050781 0.23828 -0.078125 c 0.070312 -0.027343 0.13672 -0.054687 0.20312 -0.085937 c 0.042969 -0.023438 0.089844 -0.042969 0.13281 -0.066406 c 0.10547 -0.058594 0.21094 -0.12109 0.30859 -0.1875 v -0.015626 c 0.10156 -0.074218 0.19922 -0.15234 0.29297 -0.23828 v -0.019531 c 0.082031 -0.074219 0.15625 -0.15234 0.23047 -0.23047 c 0.019531 -0.023437 0.042969 -0.046875 0.066406 -0.070312 c 0.082031 -0.09375 0.15625 -0.19531 0.22656 -0.30469 l 0.074218 -0.10938 v -0.003906 l 8.9688 -13.758 c 0.93359 -1.4375 0.51953 -3.3555 -0.91406 -4.2852 c -1.4375 -0.92969 -3.3516 -0.52734 -4.2891 0.90234 l -4.3711 6.7109 c -4.0078 -16.809 -19.168 -29.34 -37.195 -29.34 Z m -35.148 35.098 h 0.003907 c -0.12891 0 -0.25781 0.007812 -0.38281 0.027344 c -0.12891 0.015624 -0.25781 0.039062 -0.38281 0.070312 v 0.015625 c -0.125 0.03125 -0.24609 0.074219 -0.36719 0.125 c -0.12109 0.046875 -0.24219 0.10547 -0.35547 0.16797 v 0.019531 c -0.10547 0.0625 -0.21094 0.13281 -0.30859 0.20703 v 0.019532 c -0.089844 0.070312 -0.17188 0.14453 -0.25391 0.21875 c -0.03125 0.035156 -0.0625 0.066406 -0.09375 0.097656 c -0.066407 0.070312 -0.12891 0.14062 -0.1875 0.21094 c -0.023438 0.027344 -0.046876 0.050781 -0.066407 0.078125 c -0.039062 0.050782 -0.078125 0.097656 -0.11719 0.15234 l -9.0273 13.871 h 0.003906 c -0.45312 0.6875 -0.60938 1.5273 -0.44141 2.3359 c 0.16797 0.80469 0.65234 1.5117 1.3398 1.9609 c 1.4375 0.92969 3.3594 0.51953 4.2891 -0.91406 l 4.3711 -6.707 c 4.0078 16.809 19.168 29.348 37.195 29.348 c 13.652 0 26.277 -7.2812 33.105 -19.098 l 0.003907 0.003906 c 0.85547 -1.4844 0.35156 -3.3789 -1.1289 -4.2344 c -1.4805 -0.85938 -3.3789 -0.35547 -4.2383 1.125 c -5.7227 9.9062 -16.293 16.004 -27.738 16.004 c -15.637 0 -28.609 -11.121 -31.449 -25.902 l 8.5117 5.5391 c 1.4375 0.92969 3.3594 0.51953 4.293 -0.91406 c 0.92969 -1.4336 0.52734 -3.3516 -0.90625 -4.2852 l -13.879 -9.0352 v -0.003906 c -0.042969 -0.023438 -0.089843 -0.050781 -0.13281 -0.074219 v -0.007812 v -0.011719 c -0.10938 -0.0625 -0.22266 -0.11719 -0.33594 -0.16797 v -0.003906 c -0.11719 -0.050781 -0.23828 -0.09375 -0.36328 -0.125 c 0 -0.003906 -0.003906 -0.003906 -0.003906 -0.003906 v -0.003907 c -0.125 -0.03125 -0.25 -0.054687 -0.375 -0.074218 v -0.003906 c -0.12109 -0.015626 -0.24609 -0.023438 -0.37109 -0.023438 Z" />
                        </Button>
                    </StackPanel>

                    <!-- Поле для імені нового чату -->
                    <Border Grid.Row="3"
                            x:Name="NewChatInputFrame"
                            Classes="InputFrame"
                            IsVisible="{Binding IsNewChatInputVisible}"
                            Margin="16,0,16,12"
                            Padding="14,4"
                            Background="{DynamicResource SidebarCardBrush}"
                            BorderBrush="{DynamicResource SidebarCardBrush}"
                            BorderThickness="1.5"
                            CornerRadius="22">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <TextBox Background="Transparent"
                                     x:Name="NewChatInput"
                                     FocusAdorner="{x:Null}"
                                     Foreground="White"
                                     PlaceholderForeground="#8F82B3"
                                     BorderThickness="0"
                                     Padding="0,8"
                                     VerticalContentAlignment="Center"
                                     GotFocus="OnInputGotFocus"
                                     LostFocus="OnInputLostFocus"
                                     MaxLength="32"
                                     PlaceholderText="Username for new chat"
                                     Text="{Binding NewChatUsername}" />
                            <Button Grid.Column="1"
                                    Classes="ChatAction"
                                    Width="36"
                                    Height="36"
                                    CornerRadius="18"
                                    IsVisible="{Binding IsNewChatInputVisible}"
                                    Command="{Binding CreateChatCommand}"
                                    ToolTip.Tip="Create chat">
                                <PathIcon Width="18" Height="18"
                                          Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          Data="M12,1a11.085,11.085,0,0,0-2.644.32,1,1,0,0,0,.479,1.942A9.01,9.01,0,1,1,10.8,20.911c-.105-.014-.208-.03-.311-.048a8.773,8.773,0,0,1-1.076-.245,9.015,9.015,0,0,1-3.7-2.187c-.028-.028-.059-.053-.086-.081-.176-.176-.342-.361-.5-.552-.027-.031-.056-.061-.083-.093-.146-.179-.282-.366-.415-.556-.037-.052-.077-.1-.113-.157-.113-.169-.216-.346-.318-.523-.048-.083-.1-.165-.144-.25a8.951,8.951,0,0,1-.978-3.1c-.011-.089-.025-.176-.034-.265C3.017,12.573,3,12.289,3,12a9.1,9.1,0,0,1,.231-2.04,1,1,0,0,0-.748-1.2,1.011,1.011,0,0,0-.226-.026,1,1,0,0,0-.974.774A11.058,11.058,0,0,0,1,12c0,.349.02.7.053,1.043.01.109.028.216.041.324.021.17.036.341.065.508a.567.567,0,0,0,.023.062,10.889,10.889,0,0,0,1,2.986c.01.024.009.049.021.072.027.053.061.1.089.155.06.113.126.221.19.332.12.208.242.416.374.615.049.072.1.141.152.212.159.226.321.449.5.662.034.042.071.08.106.121.195.231.4.457.61.672.029.028.06.053.089.081.2.2.4.39.612.571.012.01.028.013.04.023a10.982,10.982,0,0,0,3.786,2.068l.008,0c.313.1.631.174.95.242.083.018.167.032.25.047.251.048.5.086.756.116.1.011.189.023.285.032.335.03.671.051,1.009.051A11,11,0,0,0,12,1Z M5.407,3.194A11.05,11.05,0,0,0,3.1,5.534,1,1,0,1,0,4.718,6.71,9.082,9.082,0,0,1,6.607,4.793a1,1,0,0,0,.2-1.4,1,1,0,0,0-.8-.4A.993.993,0,0,0,5.407,3.194Z M12,7a1,1,0,0,0-1,1v3H8a1,1,0,0,0,0,2h3v3a1,1,0,0,0,2,0V13h3a1,1,0,0,0,0-2H13V8A1,1,0,0,0,12,7Z" />
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Список чатів: картки; вибрана підсвічується лаймом -->
                    <ListBox Grid.Row="4"
                             Background="Transparent"
                             Padding="12,0,12,12"
                             ItemsSource="{Binding FilteredConversations}"
                             SelectedItem="{Binding SelectedConversation, Mode=TwoWay}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="models:ChatConversation">
                                <Border Classes="ChatCard" Padding="12" CornerRadius="24">
                                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="12">
                                        <Border Classes="Avatar"
                                                Grid.RowSpan="2"
                                                Width="44" Height="44"
                                                CornerRadius="22"
                                                Background="{DynamicResource AccentBrush}"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Initials}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontWeight="SemiBold"
                                                       Foreground="White" />
                                        </Border>
                                        <TextBlock Classes="ChatName"
                                                   Grid.Column="1"
                                                   Text="{Binding DisplayName}"
                                                   VerticalAlignment="Bottom"
                                                   FontWeight="SemiBold"
                                                   Foreground="White"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Classes="ChatSub"
                                                   Grid.Row="1" Grid.Column="1"
                                                   Text="Open conversation"
                                                   Margin="0,2,0,0"
                                                   FontSize="12"
                                                   Foreground="#8F82B3"
                                                   TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- ============ СВІТЛА ПАНЕЛЬ ПЕРЕПИСКИ ============ -->
            <Border Grid.Column="2"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrushMagic}"
                    BorderThickness="1"
                    CornerRadius="32"
                    ClipToBounds="True">
                <Grid RowDefinitions="Auto,*,Auto">

                    <!-- Шапка: аватар, ім'я, статус-пілюля -->
                    <Grid Grid.Row="0" Margin="15,20,15,12" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                        <Border Grid.ColumnSpan="3"
                                Background="{DynamicResource CardBrush}"
                                CornerRadius="24"
                        Padding="18,20"
                                VerticalAlignment="Center">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                                <Border Width="52" Height="52"
                                        CornerRadius="26"
                                        Background="{DynamicResource AccentGradientBrush}"
                                        IsVisible="{Binding SelectedConversation, Converter={x:Static ObjectConverters.IsNotNull}}">
                                    <TextBlock Text="{Binding SelectedConversation.Initials}"
                                               FontSize="17"
                                               FontWeight="SemiBold"
                                               Foreground="White"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>

                                <TextBlock Grid.Column="1"
                                           Text="{Binding SelectedConversation.DisplayName}"
                                           VerticalAlignment="Center"
                                           FontSize="28"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           IsVisible="{Binding SelectedConversation, Converter={x:Static ObjectConverters.IsNotNull}}" />

                                <Border Background="{DynamicResource AccentBrush}"
                                        Grid.Column="2"
                                        CornerRadius="18"
                                        Padding="14,8"
                                        VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border Width="8" Height="8"
                                                CornerRadius="4"
                                                Background="White"
                                                VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Status}"
                                                   MaxWidth="260"
                                                   TextTrimming="CharacterEllipsis"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="White"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Історія повідомлень -->
                    <ScrollViewer Grid.Row="1" Padding="28,8,28,8">
                        <StackPanel Spacing="8">
                            <Button Content="Load older messages"
                                    Classes="LoadOlderBtn"
                                    Command="{Binding LoadOlderMessagesCommand}"
                                    HorizontalAlignment="Center" />
                            <ItemsControl ItemsSource="{Binding Messages}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:ChatMessage">
                                        <Border Classes="Msg"
                                                Classes.own="{Binding IsOwnMessage}"
                                                MaxWidth="520"
                                                Margin="0,4"
                                                Padding="16,11"
                                                CornerRadius="22">
                                            <Border.ContextMenu>
                                                <ContextMenu Background="{DynamicResource CardBrush}"
                                                             CornerRadius="16"
                                                             Padding="4">
                                                    <MenuItem Header="Edit"
                                                              IsVisible="{Binding IsOwnMessage}"
                                                              Command="{Binding #MainRoot.((vm:MainViewModel)DataContext).EditMessageCommand}"
                                                              CommandParameter="{Binding}" />
                                                    <MenuItem Header="Delete"
                                                              IsVisible="{Binding IsOwnMessage}"
                                                              Command="{Binding #MainRoot.((vm:MainViewModel)DataContext).DeleteMessageCommand}"
                                                              CommandParameter="{Binding}" />
                                                </ContextMenu>
                                            </Border.ContextMenu>
                                            <StackPanel Spacing="4">
                                                <TextBlock Classes="MsgText"
                                                           Text="{Binding Content}"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Classes="MsgTime"
                                                           Text="{Binding CreatedAtUtc}"
                                                           FontSize="10"
                                                           HorizontalAlignment="Right" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Поле введення: біла «пілюля» + лаймова кругла кнопка -->
                    <Border Grid.Row="2"
                            Margin="20,8,20,20"
                            Padding="22,6,6,6"
                            Background="{DynamicResource CardBrush}"
                            CornerRadius="30">
                        <Grid ColumnDefinitions="*,Auto">
                            <Border Grid.Column="0"
                                    x:Name="MessageInputFrame"
                                    Classes="InputFrame"
                                    Background="Transparent"
                                    BorderBrush="Transparent"
                                    BorderThickness="0">
                                <TextBox Background="Transparent"
                                         x:Name="MessageInput"
                                         FocusAdorner="{x:Null}"
                                         Foreground="{DynamicResource TextBrush}"
                                         PlaceholderForeground="{DynamicResource MutedTextBrush}"
                                         BorderThickness="0"
                                         Padding="0"
                                         PlaceholderText="Enter message"
                                         VerticalContentAlignment="Center"
                                         GotFocus="OnInputGotFocus"
                                         LostFocus="OnInputLostFocus"
                                         Text="{Binding MessageText, UpdateSourceTrigger=PropertyChanged}">
                                    <TextBox.KeyBindings>
                                        <KeyBinding Gesture="Enter" Command="{Binding SendMessageCommand}" />
                                    </TextBox.KeyBindings>
                                </TextBox>
                            </Border>
                            <Button Grid.Column="1"
                                    Classes="ChatAction"
                                    Margin="10,0,0,0"
                                    Command="{Binding SendMessageCommand}"
                                    ToolTip.Tip="Send">
                                <Viewbox Width="20" Height="20"
                                         Margin="10,0,12,0">
                                    <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          Data="m96.836 3.1602c-1.0117-1.0117-2.4844-1.4062-3.8633-1.0352l-82.031 21.984c-6.4102 1.6875-10.238 8.25-8.5508 14.66 0.96094 3.6445 3.5742 6.6289 7.0625 8.0547l30.914 12.801 12.801 30.891c2.4883 6.1445 9.4844 9.1055 15.625 6.6211 3.5078-1.4219 6.1406-4.4102 7.1016-8.0703l21.977-82.043c0.36719-1.3789-0.027344-2.8516-1.0352-3.8633zm-84.348 36.262c-0.65234-0.26953-1.2227-0.69922-1.6562-1.2578-1.3594-1.7422-1.0469-4.2578 0.69531-5.6133 0.43359-0.3359 0.92969-0.58203 1.4609-0.71875l67.637-18.117-38.133 38.133zm55.664 47.598c-0.55078 2.1406-2.7344 3.4258-4.8711 2.8711-1.2461-0.32031-2.2617-1.2227-2.7266-2.4219l-12.398-29.977 38.129-38.125z" />
                                </Viewbox>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
