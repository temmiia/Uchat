<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="UChat.App.App"
             RequestedThemeVariant="Dark">

    <Application.Resources>

        <SolidColorBrush x:Key="AppBgBrush" Color="#130E1F"/>         
        <SolidColorBrush x:Key="PanelBgBrush" Color="#1D1530"/>   
        <SolidColorBrush x:Key="MagicPurpleBrush" Color="#7C3AED"/>   
        <SolidColorBrush x:Key="NeonLavenderBrush" Color="#A855F7"/> 
        <SolidColorBrush x:Key="MagicBorderBrush" Color="#3B2A63"/>  
        
        <Color x:Key="SystemAccentColor">#8B5CF6</Color>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
    </Application.Styles>
</Application>